# =============================================================================
# StreamGraph — Environment Configuration
# =============================================================================
# Centralizes all configurable parameters for the StreamGraph pipeline.
# Loaded by python-dotenv in each Python component.
#
# IMPORTANT: In a production system, sensitive values (NEO4J_PASSWORD) would
# be managed via Docker Secrets or a vault service (e.g., HashiCorp Vault).
# For this research prototype, a .env file is acceptable.
# =============================================================================

# -----------------------------------------------------------------------------
# KAFKA CONFIGURATION
# -----------------------------------------------------------------------------
# Bootstrap servers for the Kafka producer and consumers (running on host).
# Uses the EXTERNAL listener (port 9093) exposed by the Kafka container.
# NOTE: Docker-internal services (Flink) use kafka:9092 configured in
# docker-compose.yml directly. This value is for host-side Python scripts.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9093

# Topic names — centralized to avoid typos across components.
KAFKA_TOPIC_RAW=raw-transactions
KAFKA_TOPIC_SUSPICIOUS=suspicious-log
KAFKA_TOPIC_CLEARED=cleared-log
KAFKA_TOPIC_FRAUD_ALERTS=fraud-alerts
KAFKA_TOPIC_BENCHMARKS=benchmark-metrics

# Consumer group IDs.
KAFKA_CONSUMER_GROUP_GRAPH_WORKER=streamgraph-graph-worker
KAFKA_CONSUMER_GROUP_FLINK=streamgraph-flink-processor

# -----------------------------------------------------------------------------
# NEO4J CONFIGURATION
# -----------------------------------------------------------------------------
# Bolt URI for Neo4j connections from host-side Python scripts.
# The Docker-internal address (bolt://neo4j:7687) is configured in
# docker-compose.yml and is not needed here.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=streamgraph_research_2024
NEO4J_DATABASE=neo4j

# Connection pool size — max concurrent Bolt connections.
# Sized to match the graph_worker's consumer concurrency.
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# -----------------------------------------------------------------------------
# FLINK CONFIGURATION
# -----------------------------------------------------------------------------
# Parallelism for the PyFlink job.
FLINK_PARALLELISM=2

# State backend for Flink: 'hashmap' or 'rocksdb'.
# On Windows, 'hashmap' uses the JVM heap with filesystem checkpoints and prevents
# native librocksdbjni-win64.dll memory access violation crashes.
FLINK_STATE_BACKEND=hashmap

# Velocity window parameters (Tier 1 rule thresholds).
# These are the temporal anomaly detection thresholds.
VELOCITY_WINDOW_SIZE_MINUTES=15
VELOCITY_MAX_TRANSACTION_COUNT=5
VELOCITY_MAX_TOTAL_AMOUNT=10000.0

# -----------------------------------------------------------------------------
# BENCHMARKING CONFIGURATION
# -----------------------------------------------------------------------------
# Enable/disable detailed latency logging.
BENCHMARK_ENABLED=true

# Metrics export interval (seconds).
BENCHMARK_EXPORT_INTERVAL=10

# Path for local CSV metric dumps.
BENCHMARK_OUTPUT_DIR=./benchmarks

# -----------------------------------------------------------------------------
# DATA GENERATOR CONFIGURATION
# -----------------------------------------------------------------------------
# Path to the PaySim CSV dataset.
PAYSIM_CSV_PATH=./data/paysim_dataset.csv

# Ingestion rate control (transactions per second).
# Set to 0 for maximum throughput (no throttling).
PRODUCER_TARGET_TPS=1000

# Batch size for the Kafka producer's internal buffer (in bytes).
# 64 KB allows optimal batching (~120 JSON transactions per batch) without request overhead.
PRODUCER_BATCH_SIZE=65536

# Producer linger time in milliseconds — how long to wait before sending
# a batch. Higher values increase throughput at the cost of latency.
PRODUCER_LINGER_MS=20
